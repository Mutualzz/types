{
  "bugs": {
    "url": "https://github.com/Mutualzz/types.git/issues"
  },
  "devDependencies": {
    "@mutualzz/eslint-config": "workspace:*",
    "@types/node": "^25.9.1",
    "bunchee": "^6.10.0",
    "eslint": "^10.8.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**",
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "name": "@mutualzz/types",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mutualzz/types.git"
  },
  "scripts": {
    "build": "pnpm typecheck && bunchee",
    "dev": "bunchee --watch",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "4.5.0"
}
